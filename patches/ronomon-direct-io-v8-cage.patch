diff --git a/binding.c b/binding.c
--- a/binding.c
+++ b/binding.c
@@ -591,7 +591,18 @@
   // Check that pointer is aligned as we expect:
   assert(((uintptr_t)(const void *)(ptr) & (alignment - 1)) == 0);
   memset(ptr, 0, size);
   napi_value buffer;
-  OK(napi_create_external_buffer(env, size, ptr, free_aligned, NULL, &buffer));
+  // V8 memory cage (Electron 21+) forbids external buffers —
+  // napi_create_external_buffer returns napi_no_external_buffers_allowed and the
+  // OK() macro's assert dies. Copy into V8-managed memory, then free the aligned
+  // source ourselves since the free_aligned destructor we used to register no
+  // longer runs. Adapted from https://github.com/ronomon/direct-io/pull/5.
+  void *copied = NULL;
+  OK(napi_create_buffer_copy(env, size, ptr, &copied, &buffer));
+#if defined(_WIN32)
+  _aligned_free(ptr);
+#else
+  free(ptr);
+#endif
   return buffer;
 }
